// External SDK Integrations (Firebase Firestore Cloud DB & EmailJS Script Loader)
import { initializeApp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js";
import { getFirestore, collection, addDoc, getDocs, query, where, setDoc, doc, getDoc } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

// Initialize Firebase App
const app = initializeApp(window.APP_CONFIG.FIREBASE);
const db = getFirestore(app);

// Export Cloud DB utilities
window.CloudDB = { db, collection, addDoc, getDocs, query, where, setDoc, doc, getDoc };

// Dynamic EmailJS SDK Loader
window.ensureSDKLoaded = function() {
    return new Promise((resolve, reject) => {
        if (typeof window.emailjs !== "undefined") return resolve();
        const script = document.createElement("script");
        script.type = "text/javascript";
        script.src = window.APP_CONFIG.API_KEYS.SDK_URL;
        script.onload = () => resolve();
        script.onerror = () => reject(new Error("CDN network error loading EmailJS SDK."));
        document.head.appendChild(script);
    });
};
